{
  "name": "win2mac",
  "productName": "Win2Mac",
  "version": "1.1.0",
  "description": "Drag-and-drop text, files and folders between Windows and Mac through your own relay server",
  "main": "src/main.js",
  "author": "Doubixilin",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "icons": "electron scripts/make-icons.js",
    "dist:mac": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.doubilin.win2mac",
    "productName": "Win2Mac",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "icon": "build/icon.icns",
      "extendInfo": {
        "LSUIElement": false,
        "NSHumanReadableCopyright": ""
      },
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "Win2Mac"
    },
    "afterPack": "scripts/after-pack.js"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "resedit": "^1.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Doubixilin/win2mac.git"
  }
}
